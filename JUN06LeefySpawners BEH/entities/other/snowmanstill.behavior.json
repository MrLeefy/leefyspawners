{
    "format_version": "1.16.100",
    "minecraft:entity": {
        "description": {
            "identifier": "mrleefy:snowmanstill",
            "is_spawnable": false,
            "is_summonable": true,
            "is_experimental": false,
            "scripts": {
                "animate": [
                    "start",
                    {
                        "snowman_dead_summon": "!query.is_alive"
                    },
                    "bridge_execute_commands"
                ]
            },
            "animations": {
                "start": "animation.start",
                "snowman_dead_summon": "animation.snowman_dead_summon",
                "bridge_execute_commands": "controller.animation.bridge_snowman.execute_commands"
            }
        },
        "component_groups": {
            "bridge:execute_command_id_1": {
                "minecraft:skin_id": {
                    "value": 1
                }
            },
            "bridge:execute_no_command": {
                "minecraft:skin_id": {
                    "value": 0
                }
            }
        },
        "components": {
            "minecraft:physics": {
                "has_gravity": true,
                "has_collision": true
            },
            "minecraft:pushable": {
                "is_pushable": true,
                "is_pushable_by_piston": true
            },
            "minecraft:push_through": {
                "value": 1
            },
            "minecraft:loot": {
                "table": "loot_tables/entities/snowman_cancel.json"
            },
            "minecraft:nameable": {
                "always_show": false,
                "allow_name_tag_renaming": false
            },
            "minecraft:damage_sensor": {
                "triggers": {
                    "cause": "fall",
                    "deals_damage": false
                }
            },
            "minecraft:health": {
                "value": 8,
                "max": 8
            },
            "minecraft:behavior.hurt_by_target": {
                "priority": 1
            },
            "minecraft:behavior.look_at_player": {
                "priority": 2,
                "look_distance": 8.0
            },
            "minecraft:behavior.random_look_around": {
                "priority": 5
            },
            "minecraft:shooter": {
                "def": "minecraft:snowball"
            },
            "minecraft:behavior.ranged_attack": {
                "priority": 2,
                "speed_multiplier": 1.25,
                "attack_interval": 1.0,
                "attack_radius": 10.0
            },
            "minecraft:behavior.nearest_attackable_target": {
                "priority": 2,
                "must_see": true,
                "entity_types": [
                    {
                        "filters": {
                            "all_of": [
                                {
                                    "test": "is_family",
                                    "subject": "other",
                                    "value": "monster"
                                },
                                {
                                    "test": "is_family",
                                    "subject": "other",
                                    "operator": "!=",
                                    "value": "leefy"
                                }
                            ]
                        },
                        "max_dist": 16.0
                    },
                    {
                        "filters": {
                            "test": "is_family",
                            "subject": "other",
                            "value": "player"
                        },
                        "max_dist": 16.0
                    }
                ]
            },
            "minecraft:type_family": {
                "family": [
                    "leefy",
                    "mob"
                ]
            },
            "minecraft:collision_box": {
                "width": 0.7,
                "height": 1.9
            },
            "minecraft:on_hurt": {
                "event": "minecraft:on_hurt_event",
                "target": "self"
            },
            "minecraft:on_hurt_by_player": {
                "event": "minecraft:on_hurt_event",
                "target": "self"
            },
            "minecraft:conditional_bandwidth_optimization": {},
            "minecraft:movement": {
                "value": 0.0
            },
            "minecraft:movement.basic": {
                "max_turn": 30.0
            }
        },
        "events": {
            "minecraft:entity_spawned": {
                "add": {
                    "component_groups": [
                        "bridge:execute_command_id_1"
                    ]
                }
            },
            "bridge:remove_command_id_1": {
                "add": {
                    "component_groups": [
                        "bridge:execute_no_command"
                    ]
                },
                "remove": {
                    "component_groups": [
                        "bridge:execute_command_id_1"
                    ]
                }
            }
        }
    }
}