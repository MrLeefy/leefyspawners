{
  "name": "leefyspawners",
  "version": "8.2.75",
  "description": "Mob Spawner management and stacking addon for Minecraft Bedrock.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/import.ts --bundle --target=es2020 --format=esm --external:@minecraft/server --external:@minecraft/server-ui --outfile=\"JUN06LeefySpawners BEH/scripts/module/import.js\"",
    "dev": "esbuild src/import.ts --bundle --target=es2020 --format=esm --external:@minecraft/server --external:@minecraft/server-ui --outfile=\"JUN06LeefySpawners BEH/scripts/module/import.js\" --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@minecraft/server": "^2.9.0-beta.1.26.30-stable",
    "@minecraft/server-ui": "^2.2.0-beta.1.26.30-stable",
    "esbuild": "^0.20.0",
    "javascript-obfuscator": "^5.4.3",
    "typescript": "^5.0.0"
  }
}