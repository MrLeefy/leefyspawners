{
	"name": "leefyspawners",
	"version": "9.0.0",
	"description": "Realm/server-grade spawner progression, stacking, automation and economy system for Minecraft Bedrock 26.50+.",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"build": "tsc --outDir \"LeefySpawners BEH/scripts/module\"",
		"dev": "tsc --outDir \"LeefySpawners BEH/scripts/module\" --watch",
		"typecheck": "tsc --noEmit",
		"validate": "node validate-manifests.mjs",
		"migrate:api": "node migrate-bedrock-api.mjs",
		"sync:readme": "node sync-readme.mjs",
		"release:bump": "node bump-manifests.js"
	},
	"devDependencies": {
		"@minecraft/server": "2.10.0",
		"@minecraft/server-ui": "2.2.0",
		"esbuild": "^0.20.0",
		"javascript-obfuscator": "^5.4.3",
		"typescript": "^5.0.0"
	}
}
